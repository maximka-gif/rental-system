generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  TENANT
  ADMIN
}

enum PropertyType {
  APARTMENT
  HOUSE
  ROOM
  COMMERCIAL
}

enum PropertyStatus {
  VACANT
  RENTED
  MAINTENANCE
}

enum LeaseStatus {
  DRAFT
  ACTIVE
  EXPIRED
  TERMINATED
}

enum InvoiceStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum InvoiceItemType {
  RENT
  UTILITIES
  PENALTY
  DEPOSIT
  OTHER
}

enum PaymentMethod {
  CARD
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

enum RequestPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ExpenseCategory {
  REPAIR
  UTILITIES
  TAX
  INSURANCE
  CLEANING
  OTHER
}

enum NotificationType {
  INVOICE_ISSUED
  PAYMENT_REMINDER
  PAYMENT_RECEIVED
  PAYMENT_OVERDUE
  LEASE_EXPIRING
  LEASE_CREATED
  REQUEST_CREATED
  REQUEST_STATUS_CHANGED
  REQUEST_COMMENT
  SYSTEM
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role
  firstName    String
  lastName     String
  phone        String?
  avatarUrl    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  properties           Property[]
  tenants              Tenant[]              @relation("OwnerTenants")
  tenantProfile        Tenant?               @relation("TenantAccount")
  comments             RequestComment[]
  notifications        Notification[]
  notificationSettings NotificationSetting[]
  pushSubscriptions    PushSubscription[]
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Property {
  id            String         @id @default(uuid())
  ownerId       String
  title         String
  type          PropertyType   @default(APARTMENT)
  status        PropertyStatus @default(VACANT)
  city          String
  address       String
  area          Decimal?       @db.Decimal(8, 2)
  rooms         Int?
  floor         Int?
  description   String?
  baseRent      Decimal        @db.Decimal(12, 2)
  purchasePrice Decimal?       @db.Decimal(14, 2)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  owner    User                 @relation(fields: [ownerId], references: [id])
  photos   PropertyPhoto[]
  leases   Lease[]
  requests MaintenanceRequest[]
  expenses Expense[]

  @@index([ownerId])
  @@index([status])
}

model PropertyPhoto {
  id         String   @id @default(uuid())
  propertyId String
  url        String
  isCover    Boolean  @default(false)
  createdAt  DateTime @default(now())
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
}

model Tenant {
  id               String    @id @default(uuid())
  ownerId          String
  userId           String?   @unique
  firstName        String
  lastName         String
  email            String
  phone            String?
  documentNumber   String?
  birthDate        DateTime? @db.Date
  notes            String?
  reliabilityScore Int       @default(100)
  inviteToken      String?   @unique
  invitedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  owner    User                 @relation("OwnerTenants", fields: [ownerId], references: [id])
  user     User?                @relation("TenantAccount", fields: [userId], references: [id])
  leases   Lease[]
  requests MaintenanceRequest[]

  @@index([ownerId])
}

model Lease {
  id                String      @id @default(uuid())
  number            String      @unique
  propertyId        String
  tenantId          String
  status            LeaseStatus @default(DRAFT)
  startDate         DateTime    @db.Date
  endDate           DateTime    @db.Date
  rentAmount        Decimal     @db.Decimal(12, 2)
  depositAmount     Decimal     @default(0) @db.Decimal(12, 2)
  paymentDay        Int         @default(1)
  penaltyRatePerDay Decimal     @default(0.1) @db.Decimal(5, 3)
  indexationPercent Decimal     @default(0) @db.Decimal(5, 2)
  autoRenew         Boolean     @default(false)
  notes             String?
  terminatedAt      DateTime?
  terminationReason String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  property  Property        @relation(fields: [propertyId], references: [id])
  tenant    Tenant          @relation(fields: [tenantId], references: [id])
  documents LeaseDocument[]
  invoices  Invoice[]

  @@index([propertyId])
  @@index([tenantId])
  @@index([status, endDate])
}

model LeaseDocument {
  id        String   @id @default(uuid())
  leaseId   String
  name      String
  type      String
  url       String
  createdAt DateTime @default(now())
  lease     Lease    @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@index([leaseId])
}

model Invoice {
  id          String        @id @default(uuid())
  number      String        @unique
  leaseId     String
  periodStart DateTime      @db.Date
  periodEnd   DateTime      @db.Date
  issueDate   DateTime      @default(now()) @db.Date
  dueDate     DateTime      @db.Date
  totalAmount Decimal       @db.Decimal(12, 2)
  paidAmount  Decimal       @default(0) @db.Decimal(12, 2)
  status      InvoiceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  lease    Lease         @relation(fields: [leaseId], references: [id])
  items    InvoiceItem[]
  payments Payment[]

  @@index([leaseId])
  @@index([status, dueDate])
}

model InvoiceItem {
  id          String          @id @default(uuid())
  invoiceId   String
  type        InvoiceItemType
  description String
  amount      Decimal         @db.Decimal(12, 2)
  invoice     Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Payment {
  id                String        @id @default(uuid())
  invoiceId         String
  amount            Decimal       @db.Decimal(12, 2)
  method            PaymentMethod @default(CARD)
  status            PaymentStatus @default(PENDING)
  providerOrderId   String?       @unique
  providerPaymentId String?
  providerPayload   Json?
  receiptUrl        String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  invoice           Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([status])
}

model MaintenanceRequest {
  id          String          @id @default(uuid())
  propertyId  String
  tenantId    String?
  title       String
  description String
  priority    RequestPriority @default(MEDIUM)
  status      RequestStatus   @default(NEW)
  cost        Decimal?        @db.Decimal(12, 2)
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  property Property         @relation(fields: [propertyId], references: [id])
  tenant   Tenant?          @relation(fields: [tenantId], references: [id])
  photos   RequestPhoto[]
  comments RequestComment[]
  expenses Expense[]

  @@index([propertyId])
  @@index([status])
}

model RequestPhoto {
  id        String             @id @default(uuid())
  requestId String
  url       String
  createdAt DateTime           @default(now())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
}

model RequestComment {
  id        String             @id @default(uuid())
  requestId String
  authorId  String
  text      String
  createdAt DateTime           @default(now())
  request   MaintenanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author    User               @relation(fields: [authorId], references: [id])

  @@index([requestId])
}

model Expense {
  id          String              @id @default(uuid())
  propertyId  String
  requestId   String?
  category    ExpenseCategory
  amount      Decimal             @db.Decimal(12, 2)
  date        DateTime            @db.Date
  description String?
  createdAt   DateTime            @default(now())
  property    Property            @relation(fields: [propertyId], references: [id])
  request     MaintenanceRequest? @relation(fields: [requestId], references: [id])

  @@index([propertyId, date])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model NotificationSetting {
  id     String           @id @default(uuid())
  userId String
  type   NotificationType
  inApp  Boolean          @default(true)
  email  Boolean          @default(true)
  push   Boolean          @default(false)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}